{
 "name": "crewcode-mobile",
 "private": true,
 "version": "0.1.0",
 "type": "module",
 "scripts": {
  "dev": "vite --host 127.0.0.1",
  "build": "tsc --noEmit && vite build",
  "test": "vitest run",
  "typecheck": "tsc --noEmit",
  "server:build": "vite build --ssr server/index.ts --outDir dist-server",
  "tools:build": "vite build --ssr src/mcp/server-entry.ts --outDir dist-mcp",
  "pretest": "npm run tools:build",
  "server": "npm run server:build && node dist-server/index.js"
 },
 "dependencies": {
  "react": "^19.3.1",
  "react-dom": "^19.3.1"
 },
 "devDependencies": {
  "@types/node": "^26.6.6",
  "@types/react": "^19.3.0",
  "@types/react-dom": "^19.3.0",
  "@vitejs/plugin-react": "^6.3.0",
  "happy-dom": "^21.0.4",
  "typescript": "^7.0.2",
  "vite": "^8.3.7",
  "vitest": "^5.1.0"
 }
}
